# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_mas-caracteres
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Free-tier limits — verify at https://console.groq.com/settings/limits
GROQ_RATE_LIMIT_RPM=30
GROQ_RATE_LIMIT_TPM=14400
GROQ_RATE_LIMIT_TPD=200000
GROQ_RATE_LIMIT_RPD=1000

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza_mas_caracteres
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-flash-lite

# Free-tier limits — verify at https://aistudio.google.com/app/apikey
GEMINI_RATE_LIMIT_RPM=15
GEMINI_RATE_LIMIT_TPM=1000000
GEMINI_RATE_LIMIT_TPD=0  # 0 = no daily limit
GEMINI_RATE_LIMIT_RPD=1500

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-mas-caracteres
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_RATE_LIMIT_RPM=20
OPENROUTER_RATE_LIMIT_RPD=50

# ── Cloudflare Workers AI ─────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=mas-caracteres
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_RATE_LIMIT_RPM=300
CLOUDFLARE_RATE_LIMIT_TPD=10000

# ── Ollama (local, opcional como fallback) ─────────────────────────────────────
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=ollama_url_base
OLLAMA_MODEL=qwen2.5:7b

# ── Proxy ─────────────────────────────────────────────────────────────────────
PROXY_PORT=8080

# Active hours: durante esta ventana el proxy usa la cascada de proveedores cloud
ACTIVE_HOURS_START=08:00
ACTIVE_HOURS_END=23:59
TIMEZONE=America/Argentina/Buenos_Aires

# Path para persistir la cola de solicitudes pendientes entre restarts
QUEUE_PERSIST_PATH=/app/data/queue.json

# Umbral de failover: cambia de proveedor al alcanzar este porcentaje del límite (0.80 = 80%)
EXHAUSTION_THRESHOLD=0.80

# Tiempo máximo (ms) para mantener la conexión abierta antes de encolar (< 30s de Karakeep)
WAIT_MAX_MS=20000

# Nivel de log (debug | info | warn | error)
LOG_LEVEL=info
PROVIDER_ORDER=groq,gemini,cloudflare,openrouter
